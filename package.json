{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1: object-oriented SVG command-line editor",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsc -p tsconfig.json && node dist/src/bootstrap/Main.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
